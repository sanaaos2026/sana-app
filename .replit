modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
run = ["bash", "-c", "cd sana_full && export SANA_ENV=production && python3 production_init.py && exec gunicorn --bind 0.0.0.0:${PORT:-5000} --workers 2 --threads 4 --timeout 120 wsgi:app"]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sana Flask App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "sana-knowledge-release"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "drive-excerpt-browser"

[[workflows.workflow]]
name = "Sana Flask App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd sana_full && python3 app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "sana-knowledge-release"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd sana_full && python3 -m unittest test_b2b_service_os.py -v"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "drive-excerpt-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd sana_full && SANA_BROWSER_DIAGNOSTICS_RETENTION=google_drive RUN_SANA_BROWSER_TESTS=1 python3 -m unittest test_drive_index.DriveExcerptBrowserTest -v"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["fontconfig", "ghostscript", "gitFull", "glib", "harfbuzz", "pango", "playwright-driver"]

[userenv]

[userenv.shared]
ADMIN_PREVIEW_KEY = "L5ohCVX2FIIz7WUmphW8sXar"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081
