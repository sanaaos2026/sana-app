modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
run = ["bash", "-c", "cd sana_full && python3 app.py"]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sana Flask App"

[[workflows.workflow]]
name = "Sana Flask App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd sana_full && python3 app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["fontconfig", "ghostscript", "glib", "harfbuzz", "pango"]

[userenv]

[userenv.shared]
ADMIN_PREVIEW_KEY = "L5ohCVX2FIIz7WUmphW8sXar"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081
