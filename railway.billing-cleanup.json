{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "python3 -m pip install -r sana_full/requirements.txt"
  },
  "deploy": {
    "startCommand": "SANA_ENV=production SANA_BILLING_CLEANUP_WORKER=1 python3 sana_full/billing_cleanup_worker.py",
    "cronSchedule": "0 2 * * *",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}