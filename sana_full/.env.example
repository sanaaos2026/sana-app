# .env.example — متغيرات البيئة المطلوبة لتشغيل سنع
# لا تضع القيم الحقيقية هنا — استخدم Replit Secrets أو ملف .env محلي

DATABASE_URL=postgresql://user:password@session-pooler-host:5432/dbname?sslmode=require
ANTHROPIC_API_KEY=sk-ant-...
SESSION_SECRET=your-random-secret-here
ADMIN_PREVIEW_KEY=your-admin-preview-key-here
APP_URL=http://localhost:5000
SANA_ENV=development
ENABLE_EXECUTION_REMINDER_SCHEDULER=0
ENABLE_KNOWLEDGE_BACKUP_SCHEDULER=0
ENABLE_KNOWLEDGE_RESEARCH_SCHEDULER=0
