{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "python3 -m pip install -r sana_full/requirements.txt"
  },
  "deploy": {
    "preDeployCommand": [
      "SANA_ENV=production python3 sana_full/production_init.py"
    ],
    "startCommand": "SANA_ENV=production gunicorn --chdir sana_full --bind 0.0.0.0:${PORT} --workers 1 --access-logfile - --error-logfile - wsgi:app",
    "healthcheckPath": "/api/system/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}